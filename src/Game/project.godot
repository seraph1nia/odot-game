; Engine configuration. Generated caches belong in .godot/, never in Git.
config_version=5

[application]
config/version="development"
config/name="Odot - Nine Tiles"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/project_settings_override="user://renderer.cfg"
run/flush_stdout_on_print=true

[display]
window/size/viewport_width=1100
window/size/viewport_height=820
window/size/window_width_override=1100
window/size/window_height_override=820
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]
project/assembly_name="Game"

[input]

camera_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}

camera_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}

camera_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}

camera_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}

[physics]
common/physics_ticks_per_second=60

[steam]
initialization/processes/initialize_on_startup=false
multiplayer_peer/max_channels=2

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver="vulkan"
rendering_device/driver.windows="vulkan"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.075, 1)
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64

[shader_globals]
odot_weather_time={
"type": "float",
"value": 0.0
}
odot_foliage_wind={
"type": "float",
"value": 0.0
}
odot_water_motion={
"type": "float",
"value": 0.0
}
