#!/usr/bin/env bash
# Labelled acceptance fixture only: never dispatches/steers workers or lands code.
set -euo pipefail
[[ $# == 2 ]] || { printf 'Usage: inject-dependency-fault OWNED-TRIAL-WORKTREE EXPECTED-HEAD\n' >&2; exit 1; }
worktree=$(cd "$1" && pwd -P)
expected=$2
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
source_root=$(git -C "$script_dir" rev-parse --show-toplevel)
[[ "$worktree" != "$source_root" && "$expected" =~ ^[a-f0-9]{40}$ ]] || { printf 'Refusing source checkout or invalid expected revision.\n' >&2; exit 1; }
[[ -z "$(git -C "$worktree" status --porcelain)" ]] || { printf 'Refusing dirty trial worktree.\n' >&2; exit 1; }
[[ "$(git -C "$worktree" rev-parse HEAD)" == "$expected" ]] || { printf 'Trial head differs from the recorded immutable checkpoint.\n' >&2; exit 1; }
[[ "$(git -C "$worktree" symbolic-ref --short HEAD)" =~ ^fm/poc-dependency-diagnostic ]] || { printf 'Only owned fm/poc-dependency-diagnostic task branches are admitted.\n' >&2; exit 1; }
[[ -f "$worktree/openspec/changes/poc-validator-dependency-diagnostic/proposal.md" ]] || { printf 'Approved scoped trial change is missing.\n' >&2; exit 1; }
git -C "$worktree" apply --check "$script_dir/fixtures/dependency-defect.patch"
git -C "$worktree" apply "$script_dir/fixtures/dependency-defect.patch"
printf 'INJECTED CONTROLLED DEFECT in owned trial only. Record original/injected heads, label provenance, and never land this defect.\n'
